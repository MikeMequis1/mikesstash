# Site settings
SITE_NAME_HEADER=Digital Garden
SITE_NAME_HEADER_PT=Digital Garden
SITE_NAME_HEADER_EN=Digital Garden
SITE_DESCRIPTION=Uma coleção crescente de ideias, links úteis, projetos, desenhos e pequenas descobertas da web.
SITE_DESCRIPTION_PT=Uma coleção crescente de ideias, links úteis, projetos, desenhos e pequenas descobertas da web.
SITE_DESCRIPTION_EN=A growing collection of ideas, useful links, projects, drawings, and little discoveries from across the web.
# Portfolio-mode navbar header/description (fall back to the site defaults above when omitted)
PORTFOLIO_NAME_HEADER=Portfólio
PORTFOLIO_NAME_HEADER_PT=Portfólio
PORTFOLIO_NAME_HEADER_EN=Portfolio
PORTFOLIO_DESCRIPTION=Projetos, experiências e trabalhos selecionados em programação, engenharia de software e criação digital.
PORTFOLIO_DESCRIPTION_PT=Projetos, experiências e trabalhos selecionados em programação, engenharia de software e criação digital.
PORTFOLIO_DESCRIPTION_EN=Projects, experiences, and selected work in programming, software engineering, and digital creation.
SITE_BASE_URL=
SITE_MAIN_LANGUAGE=pt
BASE_THEME=dark
# Available themes shown in the theme picker: comma-separated "id:Label:giscusTheme".
# giscusTheme is optional (falls back to GISCUS_THEME_DARK).
THEMES=dark:Dark:noborder_dark,light:Light:noborder_light,lunara:Lunara,nyxa:Nyxa:noborder_light

# Theme (URL to Obsidian theme CSS, leave empty for default)
THEME=

# Feature defaults (applied to all notes unless overridden in frontmatter)
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
dgShowComments=true
dgShowLinkCards=false
dgPassFrontmatter=false

# Giscus comments (generate IDs at https://giscus.app)
GISCUS_REPO=owner/repository
GISCUS_REPO_ID=
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=
GISCUS_THEME_LIGHT=noborder_light
GISCUS_THEME_DARK=noborder_dark

# Timestamps
SHOW_CREATED_TIMESTAMP=false
SHOW_UPDATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a

# Images
USE_FULL_RESOLUTION_IMAGES=false

# Note icons
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false

# Style Settings plugin
STYLE_SETTINGS_CSS=
STYLE_SETTINGS_BODY_CLASSES=
