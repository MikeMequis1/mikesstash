{%- set hasNoteOverride = noteProps.dgShowComments is defined -%}
{%- set showComments = noteProps.dgShowComments if hasNoteOverride else settings.dgShowComments -%}
{% if showComments and meta.giscus.repo and meta.giscus.repoId and meta.giscus.category and meta.giscus.categoryId %}
<section
  class="comments"
  data-giscus-light-theme="{{ meta.giscus.lightTheme }}"
  data-giscus-dark-theme="{{ meta.giscus.darkTheme }}"
  aria-labelledby="comments-heading">
  <h2 id="comments-heading" data-title-pt="Comentários" data-title-en="Comments">{% if meta.mainLanguage == "en" %}Comments{% else %}Comentários{% endif %}</h2>
  <div class="giscus"></div>
  <script
    src="https://giscus.app/client.js"
    data-repo="{{ meta.giscus.repo }}"
    data-repo-id="{{ meta.giscus.repoId }}"
    data-category="{{ meta.giscus.category }}"
    data-category-id="{{ meta.giscus.categoryId }}"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="{{ meta.giscus.theme }}"
    data-lang="{{ meta.mainLanguage }}"
    data-loading="lazy"
    crossorigin="anonymous"
    async>
  </script>
  <script>
    (function () {
      var comments = document.querySelector(".comments");
      if (!comments) return;

      var themes = {{ meta.themes | jsonify | safe }};
      var defaultThemeId = "{{ meta.baseTheme }}";

      function currentTheme() {
        var classes = document.body.classList;
        for (var i = 0; i < themes.length; i++) {
          if (classes.contains("theme-" + themes[i].id)) return themes[i].id;
        }
        return defaultThemeId;
      }

      window.updateGiscusTheme = function (theme) {
        var frame = comments.querySelector("iframe.giscus-frame");
        if (!frame || !frame.contentWindow) return;
        var match = null;
        for (var i = 0; i < themes.length; i++) {
          if (themes[i].id === theme) { match = themes[i]; break; }
        }
        var giscusTheme =
          (match && match.giscusTheme) ||
          comments.dataset.giscusDarkTheme;
        frame.contentWindow.postMessage(
          { giscus: { setConfig: { theme: giscusTheme } } },
          "https://giscus.app"
        );
      };

      window.updateGiscusLang = function (lang) {
        var frame = comments.querySelector("iframe.giscus-frame");
        if (!frame || !frame.contentWindow) return;
        frame.contentWindow.postMessage(
          { giscus: { setConfig: { lang: lang } } },
          "https://giscus.app"
        );
      };

      function currentLang() {
        return document.body.classList.contains("lang-en") ? "en" : "pt";
      }

      function bindThemeSync() {
        var frame = comments.querySelector("iframe.giscus-frame");
        if (!frame) return false;
        frame.addEventListener(
          "load",
          function () {
            window.updateGiscusTheme(currentTheme());
            window.updateGiscusLang(currentLang());
          },
          { once: true }
        );
        window.updateGiscusTheme(currentTheme());
        window.updateGiscusLang(currentLang());
        return true;
      }

      if (!bindThemeSync()) {
        var observer = new MutationObserver(function () {
          if (bindThemeSync()) observer.disconnect();
        });
        observer.observe(comments, { childList: true, subtree: true });
      }
    })();
  </script>
</section>
{% endif %}
