{%- set hasNoteOverride = noteProps.dgShowComments is defined -%}
{%- set showComments = noteProps.dgShowComments if hasNoteOverride else settings.dgShowComments -%}
{% if showComments and meta.giscus.repo and meta.giscus.repoId and meta.giscus.category and meta.giscus.categoryId %}
<section
  class="comments"
  data-giscus-light-theme="{{ meta.giscus.lightTheme }}"
  data-giscus-dark-theme="{{ meta.giscus.darkTheme }}"
  aria-labelledby="comments-heading">
  <h2 id="comments-heading" data-title-pt="Comentários" data-title-en="Comments">{% if meta.mainLanguage == "en" %}Comments{% else %}Comentários{% endif %}</h2>
  <div class="giscus"></div>
  <script>
    (function () {
      var comments = document.querySelector(".comments");
      if (!comments) return;

      var themes = {{ meta.themes | jsonify | safe }};
      var defaultThemeId = "{{ meta.baseTheme }}";

      function currentTheme() {
        var classes = document.body.classList;
        for (var i = 0; i < themes.length; i++) {
          if (classes.contains("theme-" + themes[i].id)) return themes[i].id;
        }
        return defaultThemeId;
      }

      function currentLang() {
        return document.body.classList.contains("lang-en") ? "en" : "pt";
      }

      function giscusThemeFor(themeId) {
        for (var i = 0; i < themes.length; i++) {
          if (themes[i].id === themeId) {
            return themes[i].giscusTheme || comments.dataset.giscusDarkTheme;
          }
        }
        return comments.dataset.giscusDarkTheme;
      }

      window.updateGiscusTheme = function (theme) {
        var frame = comments.querySelector("iframe.giscus-frame");
        if (!frame || !frame.contentWindow) return;
        frame.contentWindow.postMessage(
          { giscus: { setConfig: { theme: giscusThemeFor(theme) } } },
          "https://giscus.app"
        );
      };

      window.updateGiscusLang = function (lang) {
        var frame = comments.querySelector("iframe.giscus-frame");
        if (!frame || !frame.contentWindow) return;
        frame.contentWindow.postMessage(
          { giscus: { setConfig: { lang: lang } } },
          "https://giscus.app"
        );
      };

      function bindThemeSync() {
        var frame = comments.querySelector("iframe.giscus-frame");
        if (!frame) return false;
        frame.addEventListener(
          "load",
          function () {
            window.updateGiscusTheme(currentTheme());
            window.updateGiscusLang(currentLang());
          },
          { once: true }
        );
        window.updateGiscusTheme(currentTheme());
        window.updateGiscusLang(currentLang());
        return true;
      }

      // Load giscus with the active (stored) theme and language so the first
      // render matches the page instead of the server-rendered .env defaults.
      var loader = document.createElement("script");
      loader.src = "https://giscus.app/client.js";
      loader.setAttribute("data-repo", "{{ meta.giscus.repo }}");
      loader.setAttribute("data-repo-id", "{{ meta.giscus.repoId }}");
      loader.setAttribute("data-category", "{{ meta.giscus.category }}");
      loader.setAttribute("data-category-id", "{{ meta.giscus.categoryId }}");
      loader.setAttribute("data-mapping", "pathname");
      loader.setAttribute("data-strict", "0");
      loader.setAttribute("data-reactions-enabled", "1");
      loader.setAttribute("data-emit-metadata", "0");
      loader.setAttribute("data-input-position", "top");
      loader.setAttribute("data-theme", giscusThemeFor(currentTheme()));
      loader.setAttribute("data-lang", currentLang());
      loader.setAttribute("data-loading", "lazy");
      loader.setAttribute("crossorigin", "anonymous");
      loader.async = true;
      comments.appendChild(loader);

      if (!bindThemeSync()) {
        var observer = new MutationObserver(function () {
          if (bindThemeSync()) observer.disconnect();
        });
        observer.observe(comments, { childList: true, subtree: true });
      }
    })();
  </script>
</section>
{% endif %}
